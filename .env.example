# OpenRouter server-side API key. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local: http://localhost:3000
# Production: https://your-real-domain.example
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL pooled connection string for application/runtime.
# Neon example:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# PostgreSQL direct/non-pooled connection used by Prisma migrations.
# Neon example:
# postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=

# Values used by: npm run seed
SEED_EMAIL=admin@example.com
SEED_PASSWORD=change-this-password
