# OpenRouter server-side API key. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local: http://localhost:3000
# Production: https://your-real-domain.example
NEXTAUTH_URL=http://localhost:3000

# SQLite for local development / persistent Node hosts.
DATABASE_URL="file:./dev.db"

# Optional values used only by: npm run seed
SEED_EMAIL=admin@example.com
SEED_PASSWORD=change-this-password
